package pages

import "meditrack/templates/components"

templ KioskPage() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>MediTrack - Token Kiosk</title>
			<link href="/static/css/output.css" rel="stylesheet"/>
			<script src="https://unpkg.com/htmx.org@1.9.10"></script>
		</head>
		<body class="bg-slate-100 min-h-screen flex flex-col justify-center items-center p-4">
			<div class="mb-6 text-center">
				<h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">MediTrack Health Center</h1>
				<p class="text-slate-500 text-sm">University Campus Clinic Queue System</p>
			</div>
			@components.TokenGenerator()
		</body>
	</html>
}
